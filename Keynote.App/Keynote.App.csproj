<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Keynote.Core\Keynote.Core.csproj" />
    <ProjectReference Include="..\Keynote.Midi\Keynote.Midi.csproj" />
    <ProjectReference Include="..\Keynote.Playback\Keynote.Playback.csproj" />
    <ProjectReference Include="..\Keynote.Input\Keynote.Input.csproj" />
    <ProjectReference Include="..\Keynote.Infrastructure\Keynote.Infrastructure.csproj" />
    <ProjectReference Include="..\Keynote.Online\Keynote.Online.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\visual-pianos-reference.json" />
    <Resource Include="Assets\larpiano.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\larpiano.ico</ApplicationIcon>
    <Product>larpiano</Product>
    <Description>MIDI player for Roblox pianos</Description>
    <Version>1.0.19</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
