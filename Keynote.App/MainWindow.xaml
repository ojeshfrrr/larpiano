   <TabItem x:Name="ModernTab" Header="Modern picks" Tag="♫">
    <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="Modern picks" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="A separate shortlist of the songs you asked for. Search available sources or check your own library." Foreground="{StaticResource TextMuted}" Margin="0,5,0,12" TextWrapping="Wrap"/><TextBlock Text="Some titles offer direct downloads; others require an existing library copy or a search. Check your piano mapping before playback." Foreground="#CBBEFF" Margin="0,0,0,14" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Row="1"><WrapPanel Margin="0,0,0,8"><PasswordBox x:Name="FriendsCode" Width="240" MinHeight="36" ToolTip="Friends collection access code" AutomationProperties.Name="Friends collection access code"/><Button x:Name="FriendsConnect" Content="Connect friends collection" Click="ConnectFriends" Margin="8,0,0,0"/><TextBlock x:Name="FriendsStatus" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></WrapPanel><TextBox x:Name="ModernQuery" MinHeight="36" ToolTip="Filter by title or artist" TextChanged="ModernFilterChanged" AutomationProperties.Name="Filter modern picks"/></StackPanel>
     <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="ModernList" SelectionChanged="ModernSelected" MouseDoubleClick="ModernDoubleClick" Background="#171725" Foreground="#F0F0EF" BorderBrush="#373A40" AutomationProperties.Name="Modern song shortlist"/>
      <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Selected song" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ModernDetails" Text="Select a song to search for a MIDI or find it in your library." Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" TextWrapping="Wrap"/><WrapPanel Margin="0,16,0,0"><Button x:Name="ModernDownloadButton" Content="Download and select" Click="DownloadModern" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" IsEnabled="False"/><Button x:Name="ModernSearchButton" Content="Search MIDI sources" Click="SearchModern" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" IsEnabled="False"/><Button x:Name="ModernLibraryButton" Content="Find in my library" Click="FindModernInLibrary" Margin="0,0,8,8" IsEnabled="False"/></WrapPanel><TextBlock Text="Check the source’s usage terms and inspect the MIDI and piano mapping before playback." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#11111B" BorderBrush="#353044" BorderThickness="0,1,0,0" Padding="20,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="NOW PLAYING" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock Text="{Binding Text, ElementName=SongTitle}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0"><Button x:Name="PlaybackButton" Content="Play" Click="PlayPause" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="Stop" Click="Stop"/></WrapPanel><Grid Grid.Column="2" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Elapsed" Text="0:00" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/><Slider x:Name="Progress" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Minimum="0" Maximum="100" IsEnabled="False" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5" Style="{StaticResource TimelineSlider}" ValueChanged="TimelineChanged" ToolTip="Seek through the song. Playback pauses when you seek." AutomationProperties.Name="Song timeline"/><TextBlock x:Name="Duration" Grid.Column="2" Text="0:00" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/></Grid><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"><TextBlock Text="Speed" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider x:Name="Speed" Minimum="0.5" Maximum="2" Value="1" Width="86" ValueChanged="SpeedChanged"/><TextBlock x:Name="SpeedText" Text="100%" Width="42" TextAlignment="Right" VerticalAlignment="Center"/></StackPanel></Grid></Border>
 </Grid>
</Window>
