   <TabItem Header="Discover" Tag="⌕"><Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Discover MIDI" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Search by title or artist. MIDIsss is user uploaded; Mutopia results come from its public catalogue." Foreground="{StaticResource TextMuted}" Margin="0,5,0,16" TextWrapping="Wrap"/></StackPanel><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchQuery" ToolTip="Song title or artist" TextChanged="OnlineSearchChanged" PreviewKeyDown="SearchKeyDown" GotKeyboardFocus="SearchFocus" LostKeyboardFocus="SearchBlur" MinHeight="36"/><Button Grid.Column="1" Content="Search / Retry" Click="OnlineSearch" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Cancel" Click="CancelOnline" Margin="8,0,0,0"/></Grid><WrapPanel Grid.Row="1" Margin="0,10,0,0"><ComboBox x:Name="DiscoverFilter" SelectionChanged="FilterChanged" SelectedIndex="0" Width="190" Margin="0,0,8,0"><ComboBoxItem Content="All results"/><ComboBoxItem Content="Piano-instrument candidate"/><ComboBoxItem Content="Multi-track (inspected)"/><ComboBoxItem Content="Not yet inspected"/></ComboBox><ComboBox x:Name="CatalogSelector" SelectedIndex="0" SelectionChanged="OnlineProviderChanged" Width="170"><ComboBoxItem Content="All providers"/><ComboBoxItem Content="MIDIsss"/><ComboBoxItem Content="Mutopia catalogue"/></ComboBox></WrapPanel></Grid><Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="SearchResults" Background="#171725" Foreground="#F0F0EF" BorderBrush="#373A40" SelectionChanged="OnlineResultSelected"/><ListBox x:Name="SearchSuggestions" Grid.Column="0" Visibility="Collapsed" MaxHeight="170" VerticalAlignment="Top" Background="#202033" Foreground="#F0F0EF" BorderBrush="#66686E" Panel.ZIndex="10" LostKeyboardFocus="SearchBlur" MouseDoubleClick="SuggestionChosen"/><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Arrangement details" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ResultDetails" Text="Select a result to review it." TextWrapping="Wrap" Foreground="#BFC1C4" Margin="0,10,0,0"/><WrapPanel Margin="0,14,0,0"><Button Content="Download and inspect" Click="DownloadResult" Margin="0,0,8,0"/><Button Content="Open source page" Click="OpenSelectedSource"/></WrapPanel><TextBlock x:Name="InspectionText" Foreground="#D1D2D4" TextWrapping="Wrap" Margin="0,14,0,0"/><TextBlock x:Name="PreflightText" Foreground="#CBBEFF" TextWrapping="Wrap" Margin="0,10,0,0"/><ItemsControl x:Name="TrackChoices" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" Foreground="#EEEEEE" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Import selected tracks &amp; play" Click="ImportOnline" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></ScrollViewer></Grid><StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="DiscoverStatus" Text="Search to find MIDI arrangements." Foreground="#CBBEFF" TextWrapping="Wrap"/><TextBlock x:Name="ProviderStatus" Foreground="#A5A8AD" TextWrapping="Wrap" Margin="0,5,0,0"/><Button x:Name="NextPage" Content="Next page" Click="SearchNextPage" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"/><WrapPanel Margin="0,10,0,0"><Button Content="Mutopia website" Tag="mutopia" Click="OpenProvider" Margin="0,0,8,0"/><Button Content="BitMidi website" Tag="bitmidi" Click="OpenProvider" Margin="0,0,8,0"/><Button Content="MIDI Collection website" Tag="collection" Click="OpenProvider"/></WrapPanel></StackPanel></Grid></TabItem>
   <TabItem Header="Extract" Tag="♫"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24"><TextBlock Text="Extract piano MIDI" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Optional Opennan transcription. Song-name and video searches may choose a piano cover; the source and accuracy are not guaranteed." Foreground="#A5A8AD" Margin="0,6,0,18" TextWrapping="Wrap"/><TextBlock Text="Song name or HTTPS YouTube link"/><TextBox x:Name="ExtractInput" Margin="0,6,0,12" MinHeight="36"/><WrapPanel><Button Content="Choose audio / video file" Click="ChooseAudio" Margin="0,0,8,0"/><Button Content="Clear file" Click="ClearAudio" Margin="0,0,8,0"/><TextBlock x:Name="AudioFileName" Text="No file selected" VerticalAlignment="Center" Foreground="#A5A8AD"/></WrapPanel><CheckBox x:Name="RightsCheck" Content="I have the rights to submit this content and accept Opennan's terms." Foreground="#EEEEEE" Margin="0,18,0,0"/><TextBlock Text="Provider documentation advertises three free conversions per IP per day; the general terms also state that an account is required. Only solo piano recordings, up to 10 minutes and 200 MB, are supported for uploads." Foreground="#A5A8AD" Margin="0,12,0,0" TextWrapping="Wrap"/><WrapPanel Margin="0,16,0,0"><Button Content="Convert" Click="StartExtraction" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="Cancel locally" Click="CancelOnline" Margin="0,0,8,0"/><Button Content="Opennan terms" Tag="terms" Click="OpenProvider"/></WrapPanel><ProgressBar x:Name="ExtractProgress" Margin="0,18,0,0"/><TextBlock x:Name="ExtractStatus" Text="No conversion started." Foreground="#CBBEFF" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="Cancelling stops larpiano's polling and download; the provider may continue the remote job." Foreground="#A5A8AD" Margin="0,8,0,0" TextWrapping="Wrap"/><Button Content="Inspect result" Click="InspectExtractResult" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="My Library" Tag="▤"><Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="My library" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Select a song, focus Roblox, then press Ctrl+Alt+F8." Foreground="#A5A8AD" Margin="0,6,0,16"/></StackPanel><TextBox x:Name="LibraryQuery" Grid.Row="1" ToolTip="Search your library" TextChanged="LibrarySearchChanged" MinHeight="36"/><ListBox SelectionChanged="LibrarySelected" x:Name="LibraryList" Grid.Row="2" Background="#171725" Foreground="#F0F0EF" BorderBrush="#373A40" Margin="0,12,0,12"/><StackPanel Grid.Row="3"><WrapPanel><Button Content="Refresh" Click="RefreshLibrary" Margin="0,0,8,0"/><Button Content="Inspect selected" Click="InspectLibrary" Margin="0,0,8,0"/><Button Content="Remove local entry" Click="RemoveLibrary"/></WrapPanel><TextBlock x:Name="LibraryStatus" Text="No library entries yet." Foreground="#CBBEFF" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Grid></TabItem>
   <TabItem Header="Mapping" Tag="▦"><Grid Margin="28,24,28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Keyboard mapping" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Assign a keyboard key to each MIDI pitch used by your song." Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Row="1" Margin="0,20,0,12"><Button Content="Load profile" Click="LoadProfile" Margin="0,0,8,8"/><Button Content="Save profile" Click="SaveProfile" Margin="0,0,8,8"/><Button Content="Test sequence" Click="TestSequence" Margin="0,0,20,8"/><TextBlock Text="Octave shift" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,8"/><ComboBox x:Name="Octave" Width="74" SelectedIndex="2" SelectionChanged="MappingChanged" Margin="0,0,0,8"><ComboBoxItem Content="-2"/><ComboBoxItem Content="-1"/><ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/></ComboBox></WrapPanel><Border Grid.Row="2" Background="#29263D" CornerRadius="5" Padding="12,9" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="MappingSummary" Foreground="#CBBEFF" TextWrapping="Wrap"/><TextBlock x:Name="CalibrationStatus" Foreground="#C6C6C6" Margin="0,4,0,0" Text="Edit a key cell and press A–Z or 0–9, optionally with Shift. Test keys against the game before marking verified." TextWrapping="Wrap"/><CheckBox x:Name="VerifiedCheck" Content="I manually verified this profile against the target piano" Foreground="#EAEAEA" Click="VerifyProfile" Margin="0,8,0,0"/></StackPanel></Border><DataGrid x:Name="MappingGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Background="#171725" Foreground="#F0F0EF" RowBackground="#171725" AlternatingRowBackground="#222429" BorderBrush="#373A40" BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#32343A" HeadersVisibility="Column" SelectionUnit="Cell" CellEditEnding="MappingEdit"><DataGrid.Columns><DataGridTextColumn Header="MIDI pitch" Binding="{Binding Pitch}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Note" Binding="{Binding Note}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Keyboard key (Shift supported)" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="2*"><DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><EventSetter Event="PreviewKeyDown" Handler="CaptureMappingKey"/></Style></DataGridTextColumn.EditingElementStyle></DataGridTextColumn><DataGridTemplateColumn Header="Test" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Test" Click="TestKey" Tag="{Binding}" Padding="10,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="Settings" Tag="⚙"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24,28,24"><TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Choose the window that receives playback." Foreground="{StaticResource TextMuted}" Margin="0,5,0,20"/><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20"><StackPanel><TextBlock Text="Roblox window" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Select a window, then focus it to start playback. Playback pauses if focus is lost; focus Roblox and use the shortcut to resume." Foreground="{StaticResource TextMuted}" Margin="0,7,0,16" TextWrapping="Wrap"/><TextBlock Text="Select or refresh the Roblox window on the Player screen." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/></StackPanel></Border><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="Global shortcuts" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Shortcuts work without bringing larpiano to the foreground. Choose modifiers and function keys." Foreground="{StaticResource TextMuted}" Margin="0,7,0,12" TextWrapping="Wrap"/><WrapPanel><CheckBox x:Name="HotkeyCtrl" Content="Ctrl" IsChecked="True" Foreground="#EAEAEA" Margin="0,0,12,0"/><CheckBox x:Name="HotkeyAlt" Content="Alt" IsChecked="True" Foreground="#EAEAEA" Margin="0,0,12,0"/><CheckBox x:Name="HotkeyShift" Content="Shift" Foreground="#EAEAEA" Margin="0,0,12,0"/><TextBlock Text="Play / Pause" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ToggleKey" Width="72" Margin="0,0,16,0"/><TextBlock Text="Stop" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="StopKey" Width="72" Margin="0,0,12,0"/><Button Content="Apply" Click="ApplyHotkeys"/></WrapPanel><TextBlock x:Name="HotkeyStatus" Foreground="#CBBEFF" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="Controlled playback test" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Uses your manually verified mapping and selected foreground Roblox window. Pause/resume and emergency tests require the corresponding hotkeys." Foreground="{StaticResource TextMuted}" Margin="0,7,0,12" TextWrapping="Wrap"/><WrapPanel><ComboBox x:Name="TestPattern" Width="180" SelectedIndex="0"><ComboBoxItem Content="Single note"/><ComboBoxItem Content="Five-note melody"/><ComboBoxItem Content="Three-note chord"/><ComboBoxItem Content="Tempo (500 ms beat)"/><ComboBoxItem Content="Pause / resume"/><ComboBoxItem Content="Emergency stop"/></ComboBox><Button Content="Arm test" Click="StartPlaybackTest" Margin="8,0,0,0"/><Button Content="Stop" Click="Stop" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="TestStatus" Text="No test running. Windows dispatch does not prove game receipt or an audible note." Foreground="#CBBEFF" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="Integration diagnostics" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DiagnosticsText" FontFamily="Consolas" Foreground="#C6C8CB" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="Counts cover scheduled key dispatches only; overlapping notes can share a hold. Lateness is measured at dispatch (late &gt; 10 ms); p95 uses 1 ms buckets capped at 2000 ms. Overlapping notes may share a key hold." Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="20" Margin="0,14,0,0"><StackPanel><TextBlock Text="About KEYNOTE" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Mapping profiles are saved as JSON. Only the selected foreground Roblox window receives key presses." Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Version 1.0  ·  Windows x64" Foreground="#85888E" Margin="0,16,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
